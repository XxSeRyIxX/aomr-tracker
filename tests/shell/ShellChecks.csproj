<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AoMRTracker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../shell/*.cs" Exclude="../../shell/Program.cs" />
    <EmbeddedResource Include="../../app/**/*" LogicalName="site.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

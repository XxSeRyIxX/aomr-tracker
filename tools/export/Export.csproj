<Project Sdk="Microsoft.NET.Sdk">
  <!-- Maintainer tool: writes the game data the website ships (app/data, app/art) from this computer's game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AoMRTracker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../shell/*.cs" Exclude="../../shell/Program.cs" />
  </ItemGroup>
</Project>
